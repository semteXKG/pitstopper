<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <!-- Drawn grid overlay (behind all content) -->
    <at.semmal.pitstopper.ui.TelemetryGridView
        android:id="@+id/telemetryGrid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Guidelines to divide the screen into 3 zones -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideMiddle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.42" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.72" />

    <!-- ═══════ TIER 1: RPM (top zone, 0% – 42%) ═══════ -->

    <TextView
        android:id="@+id/textRpmLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="RPM"
        android:textColor="@color/telemetry_label"
        android:textSize="28sp"
        app:layout_constraintBottom_toTopOf="@id/guideMiddle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/textRpmValue"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:maxLines="1"
        android:text="--"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        app:autoSizeMaxTextSize="400sp"
        app:autoSizeMinTextSize="40sp"
        app:autoSizeStepGranularity="2sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toTopOf="@id/textRpmLabel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ═══════ TIER 2: Speed + Throttle/Brake (middle zone, 42% – 72%) ═══════ -->

    <!-- Vertical guideline at 50% — aligns mid split with bottom row center -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideMidVertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <!-- Speed value + label (left half, centered) -->
    <TextView
        android:id="@+id/textSpeedLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:gravity="center"
        android:text="km/h"
        android:textColor="@color/telemetry_label"
        android:textSize="24sp"
        app:layout_constraintBottom_toTopOf="@id/guideBottom"
        app:layout_constraintEnd_toStartOf="@id/guideMidVertical"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/textSpeedValue"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:maxLines="1"
        android:text="--"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        app:autoSizeMaxTextSize="300sp"
        app:autoSizeMinTextSize="30sp"
        app:autoSizeStepGranularity="2sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toTopOf="@id/textSpeedLabel"
        app:layout_constraintEnd_toStartOf="@id/guideMidVertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/guideMiddle" />

    <!-- Throttle + Brake group (right half of middle row) -->
    <LinearLayout
        android:id="@+id/throttleBrakeGroup"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintBottom_toTopOf="@id/guideBottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/guideMidVertical"
        app:layout_constraintTop_toBottomOf="@id/guideMiddle">

        <!-- Throttle bar -->
        <TextView
            android:id="@+id/textThrottleLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="THR"
            android:textColor="@color/telemetry_label"
            android:textSize="28sp" />

        <FrameLayout
            android:id="@+id/throttleBarContainer"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="2dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="#333333">

            <View
                android:id="@+id/throttleBarFill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:background="@color/throttle_bar" />
        </FrameLayout>

        <TextView
            android:id="@+id/textThrottleValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="-- %"
            android:textColor="@color/text_primary"
            android:textSize="36sp" />

        <!-- Brake indicator -->
        <TextView
            android:id="@+id/textBrakeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:text="BRK"
            android:textColor="@color/telemetry_label"
            android:textSize="28sp" />

        <View
            android:id="@+id/brakeIndicator"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="2dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="#333333" />

    </LinearLayout>

    <!-- ═══════ TIER 3: Engine health row (bottom zone, 72% – 100%) ═══════ -->

    <!-- Labels pinned to parent bottom -->
    <TextView
        android:id="@+id/textCoolantLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:gravity="center"
        android:text="COOL"
        android:textColor="@color/telemetry_label"
        android:textSize="22sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/textOilTempLabel"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/textOilTempLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:gravity="center"
        android:text="OIL T"
        android:textColor="@color/telemetry_label"
        android:textSize="22sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/textOilPresLabel"
        app:layout_constraintStart_toEndOf="@id/textCoolantLabel" />

    <TextView
        android:id="@+id/textOilPresLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:gravity="center"
        android:text="OIL P"
        android:textColor="@color/telemetry_label"
        android:textSize="22sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/textBatteryLabel"
        app:layout_constraintStart_toEndOf="@id/textOilTempLabel" />

    <TextView
        android:id="@+id/textBatteryLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:gravity="center"
        android:text="BATT"
        android:textColor="@color/telemetry_label"
        android:textSize="22sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/textOilPresLabel" />

    <!-- Auto-sized values filling space above labels -->
    <TextView
        android:id="@+id/textCoolantValue"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:maxLines="1"
        android:text="--"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        app:autoSizeMaxTextSize="200sp"
        app:autoSizeMinTextSize="20sp"
        app:autoSizeStepGranularity="2sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toTopOf="@id/textCoolantLabel"
        app:layout_constraintEnd_toEndOf="@id/textCoolantLabel"
        app:layout_constraintStart_toStartOf="@id/textCoolantLabel"
        app:layout_constraintTop_toBottomOf="@id/guideBottom" />

    <TextView
        android:id="@+id/textOilTempValue"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:maxLines="1"
        android:text="--"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        app:autoSizeMaxTextSize="200sp"
        app:autoSizeMinTextSize="20sp"
        app:autoSizeStepGranularity="2sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toTopOf="@id/textOilTempLabel"
        app:layout_constraintEnd_toEndOf="@id/textOilTempLabel"
        app:layout_constraintStart_toStartOf="@id/textOilTempLabel"
        app:layout_constraintTop_toBottomOf="@id/guideBottom" />

    <TextView
        android:id="@+id/textOilPresValue"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:maxLines="1"
        android:text="--"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        app:autoSizeMaxTextSize="200sp"
        app:autoSizeMinTextSize="20sp"
        app:autoSizeStepGranularity="2sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toTopOf="@id/textOilPresLabel"
        app:layout_constraintEnd_toEndOf="@id/textOilPresLabel"
        app:layout_constraintStart_toStartOf="@id/textOilPresLabel"
        app:layout_constraintTop_toBottomOf="@id/guideBottom" />

    <TextView
        android:id="@+id/textBatteryValue"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:maxLines="1"
        android:text="--"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        app:autoSizeMaxTextSize="200sp"
        app:autoSizeMinTextSize="20sp"
        app:autoSizeStepGranularity="2sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toTopOf="@id/textBatteryLabel"
        app:layout_constraintEnd_toEndOf="@id/textBatteryLabel"
        app:layout_constraintStart_toStartOf="@id/textBatteryLabel"
        app:layout_constraintTop_toBottomOf="@id/guideBottom" />

</androidx.constraintlayout.widget.ConstraintLayout>
