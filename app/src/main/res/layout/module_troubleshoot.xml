<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header row: title + refresh button (top padding avoids overlap with MainActivity's settings/session buttons) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="80dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="@string/troubleshoot_title"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/buttonRefresh"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/troubleshoot_refresh"
                android:src="@android:drawable/ic_popup_sync"
                android:tint="@color/text_primary" />
        </LinearLayout>

        <!-- ============ WiFi Section ============ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="@string/troubleshoot_wifi_header"
            android:textColor="@color/telemetry_label"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/textWifiResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp" />

        <!-- ============ MQTT Section ============ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="@string/troubleshoot_mqtt_header"
            android:textColor="@color/telemetry_label"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textMqttResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp" />

        <!-- ============ MQTT Topics Section ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="@string/troubleshoot_topics_header"
                android:textColor="@color/telemetry_label"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/buttonTopicScan"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:fontFamily="monospace"
                android:text="@string/troubleshoot_topics_start"
                android:textSize="12sp"
                android:minWidth="100dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/textTopicsStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/textTopicsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:textIsSelectable="true" />

        <!-- ============ Network Devices Section ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="@string/troubleshoot_devices_header"
                android:textColor="@color/telemetry_label"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/buttonDeviceScan"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:fontFamily="monospace"
                android:text="@string/troubleshoot_devices_start"
                android:textSize="12sp"
                android:minWidth="100dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/textDevicesStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/textDevicesList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:textIsSelectable="true" />

    </LinearLayout>
</ScrollView>
